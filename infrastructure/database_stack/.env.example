# ============================================================================
# file: .env.example
# description: Environment variables for configuring the PostgreSQL database service.
#              Copy this file to .env and change ALL passwords before deployment!
# ============================================================================

# ====== Database Configuration ======
# Version of the TimescaleDB Docker image to use.
VERSION_POSTGRES=latest-pg15

# ====== PostgreSQL Credentials ======
# IMPORTANT: Change these values before deployment!
# Username for the PostgreSQL database.
POSTGRES_USER=lsmp_admin
# Password for the PostgreSQL database user. Use a strong, randomly generated password.
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
# Name of the default database to be created when the PostgreSQL container is initialized.
POSTGRES_DB=lsmp_db
